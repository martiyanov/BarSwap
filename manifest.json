{
  "manifest_version": 3,
  "name": "Профили закладок",
  "version": "1.0.0",
  "description": "Несколько наборов закладок на панели: на работе — одни, дома — другие, при одной учётной записи Google.",
  "permissions": ["bookmarks", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Профили закладок",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
